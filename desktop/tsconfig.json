{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": [
    "src",
    "test",
    "../src/lib/http.ts",
    "../src/lib/types.ts",
    "../src/lib/llm.ts",
    "../src/lib/extract.ts",
    "../src/lib/catalog.ts",
    "../src/lib/validate.ts",
    "../src/lib/localTargets.ts",
    "../src/lib/shopware.ts",
    "../src/lib/shopify.ts",
    "../src/lib/tiktok.ts",
    "../src/lib/hubspot.ts"
  ]
}
